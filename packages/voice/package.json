{
  "name": "@keephard/voice",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js",
    "build:bridge": "esbuild bridge/src/standalone.ts --bundle --format=iife --target=chrome110 --outfile=bridge/dist/bridge.js && esbuild bridge/src/background.ts --bundle --format=iife --target=chrome110 --outfile=bridge/dist/background.js"
  },
  "dependencies": {
    "@elevenlabs/client": "1.35.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "linkedom": "^0.18.15",
    "typescript": "^5.5.0"
  }
}
